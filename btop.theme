# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]=""

# Main text color
theme[main_fg]="#E1D6F8"

# Title color for boxes
theme[title]="#E1D6F8"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#AB92FC"

# Background color of selected item in processes box
theme[selected_bg]="#402C56"

# Foreground color of selected item in processes box
theme[selected_fg]="#E1D6F8"

# Color of inactive/disabled text
theme[inactive_fg]="#A1A0AD"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#A4D2EC"

# Box outline and divider line color
theme[cpu_box]="#AB92FC"
theme[mem_box]="#87FF5F"
theme[net_box]="#DB6088"
theme[proc_box]="#AB92FC"
theme[div_line]="#A1A0AD"

# Gradient for all meters and graphs
theme[temp_start]="#87FF5F"
theme[temp_mid]="#E6BB85"
theme[temp_end]="#DB6088"

theme[cpu_start]="#A4D2EC"
theme[cpu_mid]="#AB92FC"
theme[cpu_end]="#CE67F0"

theme[free_start]="#8EDF5F"
theme[free_mid]="#87FF5F"
theme[free_end]="#87FF5F"

theme[cached_start]="#AB92FC"
theme[cached_mid]="#B968FC"
theme[cached_end]="#B968FC"

theme[available_start]="#9DAFD1"
theme[available_mid]="#A4D2EC"
theme[available_end]="#A4D2EC"

theme[used_start]="#E6BB85"
theme[used_mid]="#D99145"
theme[used_end]="#DB6088"

theme[download_start]="#87FF5F"
theme[download_mid]="#AB92FC"
theme[download_end]="#CE67F0"

theme[upload_start]="#E6BB85"
theme[upload_mid]="#CE67F0"
theme[upload_end]="#DB6088"